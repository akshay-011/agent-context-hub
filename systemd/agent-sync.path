[Unit]
Description=Watch Context Directory for AI Agent Sync

[Path]
PathChanged=%h/workspace/agent-context-hub/context
PathChanged=%h/workspace/agent-context-hub/context/global
PathChanged=%h/workspace/agent-context-hub/context/stacks
PathChanged=%h/workspace/agent-context-hub/context/adrs
PathChanged=%h/Vault/Context
Unit=agent-sync.service

[Install]
WantedBy=default.target
